# Backend runtime configuration. This file documents the available
# environment variables; the app does not parse it. Copy values into
# mise.local.toml (gitignored) to override them locally.

# HTTP port the server listens on.
PORT=8080

# Minimum log level: debug, info, warn, error.
LOG_LEVEL=info

# Log output format: json, pretty.
LOG_FORMAT=pretty

# Max time to wait for in-flight requests to drain on shutdown
# (Go duration syntax, e.g. 10s, 1m).
SHUTDOWN_TIMEOUT=10s

# Postgres connection string for the running server. Matches the
# credentials docker-compose.yml's `db` service creates.
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# Postgres connection string `make test` migrates and runs the backend
# test suite against. Never read through config.Config — only the
# dbtest test harness reads this, via os.Getenv.
TEST_DATABASE_URL=postgres://app:app@localhost:5432/app_test?sslmode=disable
