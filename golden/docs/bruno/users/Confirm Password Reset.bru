meta {
  name: Confirm Password Reset
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/users/password-reset/confirm
  body: json
  auth: none
}

body:json {
  {
    "token": "{{resetToken}}",
    "password": "{{userNewPassword}}"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("reports the password was updated", function () {
    expect(res.getBody().message).to.include("Password updated");
  });
}
