meta {
  name: Get Current User
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/users/me
  body: none
  auth: none
}

headers {
  Cookie: {{sessionCookie}}
}

assert {
  res.status: eq 200
}

tests {
  test("returns the user the session belongs to", function () {
    const body = res.getBody();
    expect(body.email).to.equal(bru.getVar("userEmail"));
    expect(body.role).to.equal("user");
    expect(body.permissions).to.be.an("array").that.is.empty;
    expect(body.emailVerified).to.equal(true);
  });
}
