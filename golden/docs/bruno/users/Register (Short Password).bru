meta {
  name: Register (Short Password)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/users/register
  body: json
  auth: none
}

body:json {
  {
    "email": "too-short@example.com",
    "password": "short"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("error detail mentions the password is too short", function () {
    expect(res.getBody().detail).to.include("password is too short");
  });
}
