meta {
  name: Get Stub (Not Found)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/stubs/does-not-exist
  body: none
  auth: none
}

assert {
  res.status: eq 404
}

tests {
  test("error detail mentions stub not found", function () {
    expect(res.getBody().detail).to.include("stub not found");
  });
}
