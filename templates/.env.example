# Backend runtime configuration, and the only local source of it. mise
# loads this file into the environment (`[env]` in .mise.toml), so every
# `make` target and activated shell sees it; gonext's subcommands (dev,
# migrate, openapi) also load it themselves, so they work without mise.
# A variable already set in the shell takes precedence. The server
# binary itself never reads it — a deployment sets real environment
# variables.

# Deployment environment: dev, test, stg, prod. Defaults to prod, so a
# deployment that forgets to set it gets the safe behaviour. Outside
# prod the users domain returns raw confirmation/reset tokens in its
# responses and lets unconfirmed accounts log in, so local development
# works without a mail server.
ENV=dev

# HTTP port the server listens on.
PORT=8080

# Minimum log level: debug, info, warn, error.
LOG_LEVEL=info

# Log output format: json, pretty.
LOG_FORMAT=pretty

# Max time to wait for in-flight requests to drain on shutdown
# (Go duration syntax, e.g. 10s, 1m).
SHUTDOWN_TIMEOUT=10s

# Sustained requests per second one client IP may make, and how many it
# may make at once before that rate applies. In-process: each replica
# allows the full amount on its own.
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Comma-separated CIDRs of the proxies in front of the server. Empty
# means the TCP peer is the client and X-Forwarded-For is ignored. Set
# it behind a load balancer, or every request shares the balancer's
# rate-limit bucket. A catch-all such as 0.0.0.0/0 is refused at
# startup: it would let every client choose its own address.
TRUSTED_PROXIES=

# Postgres connection string for the running server. Matches the
# credentials docker-compose.yml's `db` service creates.
DATABASE_URL=postgres://app:app@localhost:5432/app?sslmode=disable

# Postgres connection string `make test` migrates and runs the backend
# test suite against. Never read through config.Config — only the
# dbtest test harness reads this, via os.Getenv.
TEST_DATABASE_URL=postgres://app:app@localhost:5432/app_test?sslmode=disable
