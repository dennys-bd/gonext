meta {
  name: Create Stub (Empty Name)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/stubs
  body: json
  auth: none
}

body:json {
  {
    "name": ""
  }
}

assert {
  res.status: eq 400
}

tests {
  test("error detail mentions name is required", function () {
    expect(res.getBody().detail).to.include("name is required");
  });
}
