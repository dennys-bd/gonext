meta {
  name: Login (New Password)
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/users/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "{{userNewPassword}}"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("the password set by Confirm Password Reset works", function () {
    expect(res.getBody().email).to.equal(bru.getVar("userEmail"));
  });
}
