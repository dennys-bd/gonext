meta {
  name: Request Password Reset (Unknown Email)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/users/password-reset
  body: json
  auth: none
}

body:json {
  {
    "email": "nobody-is-registered-here@example.com"
  }
}

assert {
  res.status: eq 202
}

tests {
  test("an unknown email is accepted with no token, revealing nothing", function () {
    const body = res.getBody();
    expect(body.message).to.be.a("string").and.not.empty;
    expect(body.token).to.equal(undefined);
  });
}
