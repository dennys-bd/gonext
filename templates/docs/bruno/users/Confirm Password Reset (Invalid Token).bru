meta {
  name: Confirm Password Reset (Invalid Token)
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/users/password-reset/confirm
  body: json
  auth: none
}

body:json {
  {
    "token": "not-a-real-token",
    "password": "an entirely different password"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("error detail mentions the reset token is invalid", function () {
    expect(res.getBody().detail).to.include("reset token is invalid");
  });
}
