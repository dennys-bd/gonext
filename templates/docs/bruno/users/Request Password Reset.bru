meta {
  name: Request Password Reset
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/users/password-reset
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userEmail}}"
  }
}

assert {
  res.status: eq 202
}

tests {
  test("returns the generic accepted message and a dev reset token", function () {
    const body = res.getBody();
    expect(body.message).to.be.a("string").and.not.empty;
    expect(body.token).to.be.a("string").and.not.empty;
  });
}

script:post-response {
  if (res.status === 202) {
    bru.setVar("resetToken", res.body.token);
  }
}
