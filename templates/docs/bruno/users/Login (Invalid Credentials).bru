meta {
  name: Login (Invalid Credentials)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/users/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{userEmail}}",
    "password": "not the right password"
  }
}

assert {
  res.status: eq 401
}

tests {
  test("error detail mentions invalid credentials", function () {
    expect(res.getBody().detail).to.include("invalid credentials");
  });
}
