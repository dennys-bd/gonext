meta {
  name: Register (Example Setup)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/users/register
  body: json
  auth: none
}

body:json {
  {
    "email": "{{exampleEmail}}",
    "password": "{{examplePassword}}"
  }
}

assert {
  res.status: eq 202
}

tests {
  test("returns a dev confirmation token", function () {
    expect(res.getBody().token).to.be.a("string").and.not.empty;
  });
}

script:pre-request {
  // The example folder owns its own session and revokes it in its
  // own Logout request, so it neither depends on nor leaks into any
  // other folder's cookies. A fresh email per run keeps a persistent
  // smoke database from taking the already-registered branch.
  bru.setVar("exampleEmail", `example-${Date.now()}-${Math.floor(Math.random() * 100000)}@example.com`);
  bru.setVar("examplePassword", "correct horse battery staple");
}

script:post-response {
  if (res.status === 202) {
    bru.setVar("exampleConfirmToken", res.body.token);
  }
}
