meta {
  name: Create Tag
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/tags
  body: json
  auth: none
}

headers {
  Cookie: {{exampleSessionCookie}}
}

body:json {
  {}
}

assert {
  res.status: eq 201
}

tests {
  test("returns a non-empty id", function () {
    const body = res.getBody();
    expect(body.id).to.be.a("string").and.not.empty;
    expect(body.createdAt).to.be.a("string").and.not.empty;
  });
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("tagId", res.body.id);
  }
}
