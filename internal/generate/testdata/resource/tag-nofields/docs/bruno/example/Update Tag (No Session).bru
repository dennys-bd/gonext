meta {
  name: Update Tag (No Session)
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/tags/does-not-exist
  body: json
  auth: none
}

body:json {
  {}
}

assert {
  res.status: eq 401
}

tests {
  test("rejects the request with no session", function () {
    expect(res.getBody().detail).to.be.a("string").and.not.empty;
  });
}
