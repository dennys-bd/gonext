meta {
  name: List Tags
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/tags
  body: none
  auth: none
}

headers {
  Cookie: {{exampleSessionCookie}}
}

assert {
  res.status: eq 200
}

tests {
  test("lists the tag created by Create Tag", function () {
    const items = res.getBody().items;
    expect(items).to.be.an("array");
    expect(items.map((item) => item.id)).to.include(bru.getVar("tagId"));
  });
}
