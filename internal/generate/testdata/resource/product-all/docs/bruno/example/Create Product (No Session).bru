meta {
  name: Create Product (No Session)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: none
}

body:json {
  {
    "title": "demo",
    "price": 42
  }
}

assert {
  res.status: eq 401
}

tests {
  test("rejects the request with no session", function () {
    expect(res.getBody().detail).to.be.a("string").and.not.empty;
  });
}
