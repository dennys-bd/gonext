meta {
  name: Create Product
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/products
  body: json
  auth: none
}

headers {
  Cookie: {{exampleSessionCookie}}
}

body:json {
  {
    "title": "demo",
    "price": 42
  }
}

assert {
  res.status: eq 201
}

tests {
  test("returns a non-empty id and echoes the fields", function () {
    const body = res.getBody();
    expect(body.id).to.be.a("string").and.not.empty;
    expect(body.title).to.equal("demo");
    expect(body.price).to.equal(42);
    expect(body.createdAt).to.be.a("string").and.not.empty;
  });
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("productId", res.body.id);
  }
}
