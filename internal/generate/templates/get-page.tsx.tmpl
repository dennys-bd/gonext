import { {{range $i, $c := .MantineImports}}{{if $i}}, {{end}}{{$c}}{{end}} } from "@mantine/core";
import { api } from "@/lib/api";
{{if .HasUsed}}
type Params = { {{range $i, $p := .Params}}{{if $i}}; {{end}}{{$p.Name}}: {{$p.TSType}}{{end}} };
{{end}}
export default async function {{.ComponentName}}({{if .HasUsed}}{
  params,
}: {
  params: Promise<Params>;
}{{end}}) {
{{if .HasUsed}}  const { {{range $i, $p := .UsedParams}}{{if $i}}, {{end}}{{$p.Name}}{{end}} } = await params;
{{end}}  const { data, error } = await {{.CallName}}({{if .HasUsed}}{ path: { {{range $i, $p := .UsedParams}}{{if $i}}, {{end}}{{if $p.CatchAll}}{{$p.Name}}: {{$p.PathExpr}}{{else}}{{$p.Name}}{{end}}{{end}} } }{{end}});

  return (
    <>
      <Title order={1}>{{.Title}}</Title>
      {error && (
        <Text c="red" role="alert">
          {{if .HasDetail}}{error.detail ?? "Request failed"}{{else}}Request failed{{end}}
        </Text>
      )}
{{if eq .ResponseKind "object"}}      {data && (
        <dl>
{{range .Fields}}{{if .Todo}}          {/* TODO: {{.Name}} is not a primitive; render it manually */}
{{else}}          <dt>{{.Name}}</dt>
          <dd>{{if .IsBoolean}}{String(data.{{.Name}})}{{else}}{data.{{.Name}}}{{end}}</dd>
{{end}}{{end}}        </dl>
      )}
{{else if eq .ResponseKind "value"}}      {data !== undefined && (
        <pre>{JSON.stringify(data, null, 2)}</pre>
      )}
{{else}}      {!error && <Text>Done</Text>}
{{end}}    </>
  );
}
