func Test{{.Pascal}}Repository_CreateAndGet(t *testing.T) {
	repo := New{{.Pascal}}Repository()
	ctx := context.Background()
	{{.Camel}} := test{{.Pascal}}("{{.Name}}-1", time.Now().UTC())

	if err := repo.Create(ctx, {{.Camel}}); err != nil {
		t.Fatalf("create: unexpected error: %v", err)
	}

	got, err := repo.Get(ctx, {{.Camel}}.ID)
	if err != nil {
		t.Fatalf("get: unexpected error: %v", err)
	}
	if got != {{.Camel}} {
		t.Fatalf("expected %+v, got %+v", {{.Camel}}, got)
	}
}

