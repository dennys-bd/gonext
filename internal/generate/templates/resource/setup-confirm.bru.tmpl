meta {
  name: [[.Request]]
  type: http
  seq: [[.Seq]]
}

post {
  url: {{baseUrl}}/users/confirm-email
  body: json
  auth: none
}

body:json {
  {
    "token": "{{[[.DomainCamel]]ConfirmToken}}"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("confirms the account so login does not depend on a relaxed ENV", function () {
    expect(res.getBody().message).to.be.a("string").and.not.empty;
  });
}
