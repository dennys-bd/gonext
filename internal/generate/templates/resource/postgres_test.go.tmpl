func Test{{.Pascal}}Repository_CreateAndGet(t *testing.T) {
	db, _ := dbtest.New(t)
	repo := postgres.New{{.Pascal}}Repository(db)
	ctx := context.Background()
	{{.Camel}} := test{{.Pascal}}("{{.Name}}-1", time.Now().UTC().Truncate(time.Microsecond))

	if err := repo.Create(ctx, {{.Camel}}); err != nil {
		t.Fatalf("create: %v", err)
	}

	got, err := repo.Get(ctx, {{.Camel}}.ID)
	if err != nil {
		t.Fatalf("get: %v", err)
	}
	if !same{{.Pascal}}(got, {{.Camel}}) {
		t.Fatalf("expected %+v, got %+v", {{.Camel}}, got)
	}
}

