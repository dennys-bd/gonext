func Test{{.Pascal}}Service_Update(t *testing.T) {
	repo := memory.New{{.Pascal}}Repository()
	svc := New{{.Pascal}}Service(repo)
	seeded := seed{{.Pascal}}(t, repo, "{{.Name}}-1")

	updated, err := svc.Update{{.Pascal}}(context.Background(), seeded.ID{{range .Fields}}, {{.Type.GoUpdated}}{{end}})
	if err != nil {
