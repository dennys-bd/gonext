	if !updated.CreatedAt.Equal(seeded.CreatedAt) || !updated.UpdatedAt.After(seeded.UpdatedAt) {
		t.Fatalf("expected CreatedAt kept and UpdatedAt advanced, got %+v", updated)
	}
}

