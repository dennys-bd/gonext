func Test{{.Pascal}}Service_Create(t *testing.T) {
	repo := memory.New{{.Pascal}}Repository()
	svc := New{{.Pascal}}Service(repo)
	ctx := context.Background()

	created, err := svc.Create{{.Pascal}}(ctx{{range .Fields}}, {{.Type.GoSample}}{{end}})
	if err != nil {
		t.Fatalf("create: unexpected error: %v", err)
	}
	if created.ID == ""{{range .Fields}} || {{printf .Mismatch "created"}}{{end}} {
		t.Fatalf("unexpected {{.Human}}: %+v", created)
	}
	if created.CreatedAt.IsZero() || !created.UpdatedAt.Equal(created.CreatedAt) {
		t.Fatalf("expected both timestamps set to the creation time, got %+v", created)
	}
{{if .Op.Get}}
	got, err := repo.Get(ctx, created.ID)
	if err != nil {
		t.Fatalf("get: unexpected error: %v", err)
	}
	if got != created {
		t.Fatalf("expected %+v, got %+v", created, got)
	}
{{end}}}
