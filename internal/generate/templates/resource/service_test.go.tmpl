func seed{{.Pascal}}(t *testing.T, repo *memory.{{.Pascal}}Repository, id string) domain.{{.Pascal}} {
	t.Helper()
	at := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
	{{.Camel}} := domain.{{.Pascal}}{
		ID: id,
{{range .Fields}}		{{.Pascal}}: {{.Type.GoSample}},
{{end}}		CreatedAt: at,
		UpdatedAt: at,
	}
	if err := repo.Create(context.Background(), {{.Camel}}); err != nil {
		t.Fatalf("seeding a {{.Human}}: %v", err)
	}
	return {{.Camel}}
}
