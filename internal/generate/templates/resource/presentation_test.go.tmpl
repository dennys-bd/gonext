// seed{{.Pascal}} stores a {{.Human}} through the repository, not the API, so
// the read and write cases do not depend on the create endpoint.
func seed{{.Pascal}}(t *testing.T, repo *memory.{{.Pascal}}Repository) domain.{{.Pascal}} {
	t.Helper()
	at := time.Date(2026, 1, 1, 0, 0, 0, 0, time.UTC)
	{{.Camel}} := domain.{{.Pascal}}{
		ID: "{{.Name}}-1",
{{range .Fields}}		{{.Pascal}}: {{.Type.GoSample}},
{{end}}		CreatedAt: at,
		UpdatedAt: at,
	}
	if err := repo.Create(context.Background(), {{.Camel}}); err != nil {
		t.Fatalf("seeding a {{.Human}}: %v", err)
	}
	return {{.Camel}}
}
