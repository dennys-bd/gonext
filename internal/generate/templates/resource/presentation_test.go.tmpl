// {{.Camel}}RejectingResolver stands in for a provider with no valid sessions.
type {{.Camel}}RejectingResolver struct{}

func ({{.Camel}}RejectingResolver) Resolve(context.Context, string) (auth.Identity, error) {
	return auth.Identity{}, auth.ErrUnauthenticated
}
{{if .AnySecured}}
// {{.Camel}}AcceptingResolver treats any credential as a valid session.
type {{.Camel}}AcceptingResolver struct{}

func ({{.Camel}}AcceptingResolver) Resolve(context.Context, string) (auth.Identity, error) {
	return auth.Identity{UserID: "u-1"}, nil
}

// {{.Camel}}Session is the header a secured request sends; the accepting
// resolver never looks at its value.
const {{.Camel}}Session = "Cookie: " + auth.DefaultCookieName + "=x"
{{end}}
func new{{.Pascal}}TestAPI(t *testing.T, resolver auth.Resolver) (humatest.TestAPI, *memory.{{.Pascal}}Repository) {
	t.Helper()

	logger := slog.New(slog.NewTextHandler(io.Discard, nil))
	_, api := humatest.New(t)
	api.UseMiddleware(apipkg.NewAuthMiddleware(api, resolver, apipkg.ProvideAuthConfig(), logger))

	repo := memory.New{{.Pascal}}Repository()
	Register{{.Pascal}}(api, application.New{{.Pascal}}Service(repo), logger)
	return api, repo
}
