// Delete removes the {{.Pascal}} with the given id, or returns domain.Err{{.Pascal}}NotFound.
func (r *{{.Pascal}}Repository) Delete(ctx context.Context, id string) error {
	res, err := r.db.NewDelete().Model(&{{.Camel}}Row{ID: id}).WherePK().Exec(ctx)
	if err != nil {
		return fmt.Errorf("deleting {{.Human}}: %w", err)
	}
	affected, err := res.RowsAffected()
	if err != nil {
		return fmt.Errorf("deleting {{.Human}}: %w", err)
	}
	if affected == 0 {
		return domain.Err{{.Pascal}}NotFound
	}
	return nil
}
