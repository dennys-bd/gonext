type {{.Camel}}Row struct {
	bun.BaseModel `bun:"table:{{.Table}}"`

	ID string `bun:"id,pk"`
{{range .Fields}}	{{.Pascal}} {{.Type.Go}} `bun:"{{.Column}}"`
{{end}}	CreatedAt time.Time `bun:"created_at"`
	UpdatedAt time.Time `bun:"updated_at"`
