// Create stores {{.Camel}}.
func (r *{{.Pascal}}Repository) Create(ctx context.Context, {{.Camel}} domain.{{.Pascal}}) error {
	row := to{{.Pascal}}Row({{.Camel}})
	if _, err := r.db.NewInsert().Model(&row).Exec(ctx); err != nil {
		return fmt.Errorf("creating {{.Human}}: %w", err)
	}
