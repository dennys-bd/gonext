// Get retrieves the {{.Pascal}} with the given id, or domain.Err{{.Pascal}}NotFound.
func (r *{{.Pascal}}Repository) Get(ctx context.Context, id string) (domain.{{.Pascal}}, error) {
	var row {{.Camel}}Row
	if err := r.db.NewSelect().Model(&row).Where("id = ?", id).Scan(ctx); err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return domain.{{.Pascal}}{}, domain.Err{{.Pascal}}NotFound
		}
		return domain.{{.Pascal}}{}, fmt.Errorf("querying {{.Human}}: %w", err)
	}
	return from{{.Pascal}}Row(row), nil
}
{{end}}{{if .Op.List}}
// List returns up to limit {{.PluralPascal}} after skipping offset, newest first then by id.
func (r *{{.Pascal}}Repository) List(ctx context.Context, limit, offset int) ([]domain.{{.Pascal}}, error) {
	rows := make([]{{.Camel}}Row, 0)
	err := r.db.NewSelect().Model(&rows).Order("created_at DESC", "id").Limit(limit).Offset(offset).Scan(ctx)
	if err != nil {
		return nil, fmt.Errorf("listing {{.PluralHuman}}: %w", err)
	}
	{{.PluralCamel}} := make([]domain.{{.Pascal}}, 0, len(rows))
	for _, row := range rows {
		{{.PluralCamel}} = append({{.PluralCamel}}, from{{.Pascal}}Row(row))
	}
	return {{.PluralCamel}}, nil
}
{{end}}{{if .Op.Update}}
// Update replaces the stored {{.Pascal}}'s fields and UpdatedAt with {{.Camel}}'s
// in one write and returns the stored row, or domain.Err{{.Pascal}}NotFound.
func (r *{{.Pascal}}Repository) Update(ctx context.Context, {{.Camel}} domain.{{.Pascal}}) (domain.{{.Pascal}}, error) {
	row := to{{.Pascal}}Row({{.Camel}})
	err := r.db.NewUpdate().Model(&row).Column({{range .Fields}}"{{.Column}}", {{end}}"updated_at").WherePK().Returning("*").Scan(ctx)
	if err != nil {
		if errors.Is(err, sql.ErrNoRows) {
			return domain.{{.Pascal}}{}, domain.Err{{.Pascal}}NotFound
		}
		return domain.{{.Pascal}}{}, fmt.Errorf("updating {{.Human}}: %w", err)
	}
	return from{{.Pascal}}Row(row), nil
}
