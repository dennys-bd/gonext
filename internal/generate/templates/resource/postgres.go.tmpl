type {{.Pascal}}Repository struct {
	db bun.IDB
}

// New{{.Pascal}}Repository constructs a {{.Pascal}}Repository backed by db.
func New{{.Pascal}}Repository(db bun.IDB) *{{.Pascal}}Repository {
