// Command gonext-migrate-runner is a temporary file materialized by
// `gonext migrate` to bring a generated project's Postgres schema to
// the pending state (or, given a target, one domain to one version).
// It is deleted immediately after running and should never be
// committed.
package main

import (
	"bufio"
	"context"
	"errors"
	"fmt"
	"os"
	"strings"

	"github.com/dennys-bd/gonext/dbmigrate"

	"[MODULE-PATH]/backend/internal/config"
	"[MODULE-PATH]/backend/internal/database"
[MIGRATION-IMPORTS])

func main() {
	target, yes, err := parseArgs(os.Args[1:])
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}

	cfg, err := config.Load()
	if err != nil {
		fmt.Fprintf(os.Stderr, "config: %v\n", err)
		os.Exit(1)
	}

	ctx := context.Background()
	db, err := database.Connect(ctx, cfg.DatabaseURL)
	if err != nil {
		fmt.Fprintf(os.Stderr, "connecting to database: %v\n", err)
		os.Exit(1)
	}
	defer db.Close()

	if target == "" {
		applied, err := dbmigrate.Apply(ctx, db)
		for _, m := range applied {
			fmt.Printf("applied %s/%s %s\n", m.Domain, m.Version, m.Name)
		}
		if err != nil {
			fmt.Fprintf(os.Stderr, "running migrations: %v\n", err)
			os.Exit(1)
		}
		if len(applied) == 0 {
			fmt.Println("no new migrations to run")
		}
		return
	}

	parsedTarget, err := dbmigrate.ParseTarget(target)
	if err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}

	confirm := func(rollback []dbmigrate.Migration) bool {
		for _, m := range rollback {
			fmt.Printf("rollback %s/%s %s\n", m.Domain, m.Version, m.Name)
		}
		if yes {
			return true
		}
		fmt.Print("Proceed? [y/N] ")
		reader := bufio.NewReader(os.Stdin)
		line, _ := reader.ReadString('\n')
		line = strings.TrimSpace(line)
		return line == "y" || line == "Y" || strings.EqualFold(line, "yes")
	}

	rolledBack, applied, err := dbmigrate.Migrate(ctx, db, parsedTarget, confirm)
	for _, m := range rolledBack {
		fmt.Printf("rolled back %s/%s %s\n", m.Domain, m.Version, m.Name)
	}
	for _, m := range applied {
		fmt.Printf("applied %s/%s %s\n", m.Domain, m.Version, m.Name)
	}
	if errors.Is(err, dbmigrate.ErrNotConfirmed) {
		fmt.Fprintln(os.Stderr, "aborted")
		os.Exit(1)
	}
	if err != nil {
		fmt.Fprintf(os.Stderr, "running migrations: %v\n", err)
		os.Exit(1)
	}
	if len(rolledBack) == 0 && len(applied) == 0 {
		fmt.Println("nothing to do")
	}
}

// parseArgs splits the runner's own args into an optional
// "<domain>/<version>" target and the --yes flag, which may appear
// anywhere among them.
func parseArgs(args []string) (target string, yes bool, err error) {
	for _, arg := range args {
		if arg == "--yes" {
			yes = true
			continue
		}
		if target != "" {
			return "", false, errors.New("usage: gonext migrate [<domain>/<version>] [--yes]")
		}
		target = arg
	}
	return target, yes, nil
}
